# -----------------------------------------------------------------------------
# PATELLA B2B SUPPLY CHAIN CUSTODY & ESCROW COORDINATION
# Environment Variables Template (.env.example)
# Target Stack: Next.js + Fastify + PostgreSQL + Celo
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 1. APPLICATION & FRONTEND
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Patela Fastify backend (backend/). Routes have no /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Google Identity Services Web client ID (same as the backend GOOGLE_OAUTH_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
API_PORT=4000

# -----------------------------------------------------------------------------
# 2. DATABASE & REDIS (PostgreSQL 16 + Redis 7)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://patela:patela_dev_password@localhost:5432/patela_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & GUEST HANDOFF SECURITY
# -----------------------------------------------------------------------------
SESSION_SECRET="replace-with-at-least-32-bytes-of-cryptographic-random-hex"
CSRF_SECRET="replace-with-at-least-32-bytes-of-cryptographic-random-hex"
SESSION_COOKIE_NAME="patela_sid"
GUEST_HANDOFF_TOKEN_SECRET="replace-with-at-least-32-bytes-of-cryptographic-random-hex"
GUEST_HANDOFF_TOKEN_TTL_SECONDS=14400

# -----------------------------------------------------------------------------
# 4. PRIVATE OBJECT STORAGE (MinIO / S3 / Cloudflare R2)
# -----------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="af-south-1"
S3_BUCKET_EVIDENCE="patella-evidence-vault"
S3_ACCESS_KEY_ID="patela_minio_admin"
S3_SECRET_ACCESS_KEY="patela_minio_secret_key"
S3_SIGNED_URL_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# 5. BLOCKCHAIN & ESCROW — CELO SEPOLIA (Chain ID 11142220)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=11142220
CELO_SEPOLIA_RPC_URL="https://forno.celo-sepolia.celo-testnet.org"
NEXT_PUBLIC_RPC_URL="https://forno.celo-sepolia.celo-testnet.org"
# Canonical Mento ZARm on Celo Sepolia. Mainnet: 0x4c35853A3B4e647fD266f4de678dCc8fEC410BF6
NEXT_PUBLIC_ZARM_ADDRESS="0x10CCfB235b0E1Ed394bACE4560C3ed016697687e"
NEXT_PUBLIC_ESCROW_ADDRESS="0x0000000000000000000000000000000000000000"
NEXT_PUBLIC_ANCHOR_REGISTRY_ADDRESS="0x0000000000000000000000000000000000000000"

# Release Authority (AWS KMS / Cloud HSM) - signs verified release instructions
RELEASE_AUTHORITY_KMS_KEY_ID=""
RELEASE_AUTHORITY_ADDRESS=""
INDEXER_CONFIRMATION_BLOCKS=2
INDEXER_POLL_INTERVAL_MS=3000

# Foundry contract deployment credentials (never exposed in web app)
DEPLOYER_PRIVATE_KEY=""
CELOSCAN_API_KEY=""
# Mandatory deployment safety ceiling on Celo networks.
MAX_ORDER_ZARM="10000"

# -----------------------------------------------------------------------------
# 6. SOUTH AFRICAN BANKING & FIAT SETTLEMENT
# -----------------------------------------------------------------------------
BANK_INTEGRATION_PROVIDER="standard_bank"
BANK_CLIENT_TRUST_ACCOUNT_REF="STB-ZA-ESCROW-001"
BANK_WEBHOOK_SECRET=""
FIAT_CURRENCY_DEFAULT="ZAR"

# -----------------------------------------------------------------------------
# 7. NOTIFICATION GATEWAY (SMS / WhatsApp for Driver Guest Links)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""

# -----------------------------------------------------------------------------
# 8. ADVISORY AI OCR & DOCUMENT EXTRACTION
# -----------------------------------------------------------------------------
AI_PROVIDER="gemini"
AI_MODEL_NAME="gemini-2.5-flash"
AI_API_KEY=""
AI_MAX_INPUT_CHARS=64000
AI_REQUEST_TIMEOUT_MS=45000

