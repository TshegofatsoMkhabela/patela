PORT=4000
DATABASE_URL=postgres://postgres:password@localhost:54322/postgres
GOOGLE_OAUTH_CLIENT_ID=
# Optional: enables the authorization-code flow in addition to ID-token sign-in.
GOOGLE_OAUTH_CLIENT_SECRET=
# Set true only for a temporary API-hosted Google sign-in smoke test.
ENABLE_AUTH_SMOKE_PAGE=false
PUBLIC_ORIGIN=http://localhost:3000
# Optional comma-separated additional browser origins (no paths).
ALLOWED_ORIGINS=
API_ORIGIN=http://localhost:4000
# Leave COOKIE_DOMAIN blank for host-only cookies. Use None only with an HTTPS API.
COOKIE_DOMAIN=
COOKIE_SAME_SITE=Lax
PG_POOL_MAX=2
# Celo Sepolia defaults. Use CHAIN_ID=42220 and the mainnet RPC only after audit/release approval.
# Set RPC_URL and ESCROW_ADDRESS together (startup refuses one without the other); leave both
# blank to run sign-in and onboarding only. Celo Sepolia public RPC:
#   RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# Check the pair with `npm run chain:check` before relying on it.
RPC_URL=
CHAIN_ID=11142220
# Optional override; blank selects canonical Mento ZARm for the chain.
TOKEN_ADDRESS=
TOKEN_DECIMALS=18
ESCROW_ADDRESS=
CHAIN_CONFIRMATIONS=3
GOOGLE_MAPS_SERVER_KEY=
# Google Cloud speech clients use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
